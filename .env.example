# Copy to .env and fill in.

NVIDIA_API_KEY=
PARADOX_AUTH_MODE=none

# Become the owner (pick at least one):
# 1) Secret you paste in the UI "Owner key" box when adding models
PARADOX_OWNER_KEY=change-me-to-a-long-random-string
# 2) Email(s) that become owner on signup (accounts mode)
CREATOR_EMAILS=you@example.com

# Laptop-only: let the single local user add providers without a key
# PARADOX_ALLOW_LOCAL_PROVIDER_EDIT=1

# Off by default. Only turn these on if you understand the risk.
PARADOX_ENABLE_EXEC=0
PARADOX_ENABLE_BROWSE=0

PARADOX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PARADOX_STARTING_CREDITS=50

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE=http://localhost:8000
